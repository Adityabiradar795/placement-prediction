import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import warnings

warnings.filterwarnings('ignore')


df = pd.read_csv('data.csv')


df.head()


df.duplicated().sum()


df.shape


df.info()


df.describe()


num_col = df.select_dtypes(include='number').columns


print(num_col)


plt.figure(figsize=(12,8))
def box_plot(col,num):
    plt.subplot(4,4,num)
    sns.boxplot(data=df,y=col)
i=1
for col in num_col:
    box_plot(col,i)
    i+=1
plt.tight_layout()
plt.show()


plt.figure(figsize=(12,8))
def box_plot(col,num):
    plt.subplot(4,4,num)
    sns.histplot(df[col],kde=True)
i=1
for col in num_col:
    box_plot(col,i)
    i+=1
plt.tight_layout()
plt.show()


plt.figure(figsize=(14, 10))

sns.heatmap(
    df.corr(numeric_only=True),
    annot=True,
    fmt=".2f",
    cmap="rocket",
    annot_kws={"size": 8}
)

plt.xticks(rotation=60, ha="right")
plt.yticks(rotation=0)
plt.tight_layout()
plt.show()


