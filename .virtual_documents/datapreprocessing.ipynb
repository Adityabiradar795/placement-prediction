drop_cols = ['Student_ID', 'Placement_Status', 'Company_Tier', 
             'Career_Field', 'Placement_Mode', 'Starting_Salary_USD']
skewed_cols = ['Resume_Score']
numeric_cols = ['Age', 'Attendance_Percentage', 'Study_Hours_Per_Week', 'CGPA',
                'Programming_Skill', 'Projects_Completed', 'Certifications',
                'Hackathons', 'Internships', 'Communication_Skills',
                'Teamwork', 'Problem_Solving', 'Interview_Score', 'Employability_Score']

# Ordinal columns -> OrdinalEncoder (natural order hai inme)
ordinal_cols = ['University_Year', 'Academic_Performance', 'English_Proficiency']

nominal_cols = ['Gender', 'Major']

binary_cols = ['GitHub_Profile', 'Leadership_Experience', 'LinkedIn_Profile']


feature_col = numeric_cols + ordinal_cols + nominal_cols + binary_cols + skewed_cols


# ordinal cols ka order define kar raha hu 
university_year_order = ['Freshman', 'Sophomore', 'Junior', 'Senior']
academic_perf_order = ['Poor', 'Average', 'Good', 'Excellent']
english_prof_order = ['Basic', 'Intermediate', 'Advanced']


from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler,OneHotEncoder,OrdinalEncoder,PowerTransformer


num_col1 = df.select_dtypes(include='number')
num_col1.skew()





skewed_pipeline = Pipeline(steps = [
    ('power',PowerTransformer(method='yeo-johnson')),
    ('scale',StandardScaler())
])

normal_pipeline = Pipeline(steps=[
    ('scale',StandardScaler())
])

ordinal_pipeline = Pipeline(steps = [
    ('encode' ,OrdinalEncoder(categories = [university_year_order,academic_perf_order,english_prof_order]))
])

nominal_pipeline = Pipeline(steps = [
    ('encode',OneHotEncoder(handle_unknown='ignore'))
])

binary_pipeline = Pipeline(steps = [
    ('encode',OneHotEncoder(drop='if_binary',handle_unknown='ignore'))
])


preprocessor = ColumnTransformer(
    transformers=[
        ('skewed',skewed_pipeline,skewed_cols),
        ('normal',normal_pipeline,numeric_cols),
        ('ordinal',ordinal_pipeline,ordinal_cols),
        ('nominal',nominal_pipeline,nominal_cols),
        ('binary',binary_pipeline,binary_cols)
    ],
    remainder='drop'
)


X = df[feature_col]
y = df['Placement_Status']


from sklearn.model_selection import train_test_split
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.30, random_state=42)


get_ipython().getoutput("pip install imbalanced-learn")


from imblearn.over_sampling import SMOTE
from imblearn.pipeline import Pipeline as ImbPipeline
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix

clf_pipeline = ImbPipeline(steps=[
    ('preprocessor', preprocessor),
    ('smote', SMOTE(random_state=42)),
    ('model', RandomForestClassifier(n_estimators=200, random_state=42))
])

clf_pipeline.fit(X_train, y_train)

rfc_pred = clf_pipeline.predict(X_test)

print("Accuracy:", accuracy_score(y_test, rfc_pred))
print(classification_report(y_test, rfc_pred))
print(confusion_matrix(y_test, rfc_pred))


