df_placed = df[df['Placement_Status'] == 'Placed']

X_reg = df_placed[feature_col]
y_reg = df_placed['Starting_Salary_USD']


X_train_r, X_test_r, y_train_r, y_test_r = train_test_split(X_reg, y_reg, test_size=0.2, random_state=42)


skewed_pipeline = Pipeline(steps=[
    ('power', PowerTransformer(method='yeo-johnson')),
    ('scale', StandardScaler())
])
normal_pipeline = Pipeline(steps=[
    ('scale', StandardScaler())
])
ordinal_pipeline = Pipeline(steps=[
    ('encode', OrdinalEncoder(categories=[
        university_year_order, academic_perf_order, english_prof_order
    ]))
])
nominal_pipeline = Pipeline(steps=[
    ('encode', OneHotEncoder(handle_unknown='ignore'))
])
binary_pipeline = Pipeline(steps=[
    ('encode', OneHotEncoder(drop='if_binary', handle_unknown='ignore'))
])


preprocessor_reg = ColumnTransformer(
    transformers=[
        ('skewed', skewed_pipeline, skewed_cols),
        ('normal', normal_pipeline, numeric_cols),
        ('ordinal', ordinal_pipeline, ordinal_cols),
        ('nominal', nominal_pipeline, nominal_cols),
        ('binary', binary_pipeline, binary_cols)
    ],
    remainder='drop'
)


from xgboost import XGBRegressor

reg_pipeline = Pipeline(steps=[
    ('preprocessor', preprocessor_reg),
    ('model', XGBRegressor(n_estimators=200, random_state=42))
])

reg_pipeline.fit(X_train_r, y_train_r)
salary_pred = reg_pipeline.predict(X_test_r)


from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
