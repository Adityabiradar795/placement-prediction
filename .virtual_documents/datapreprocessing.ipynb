y_test_enc = le.transform(y_test)

for weight in [0.15, 0.2, 0.3, 0.4, 0.5, 0.7, 1]:
    pipeline = Pipeline(steps=[
        ('preprocessor', preprocessor),
        ('model', XGBClassifier(
            n_estimators=200,
            random_state=42,
            eval_metric='logloss',
            scale_pos_weight=weight
        ))
    ])
    pipeline.fit(X_train, y_train_enc)
    pred = pipeline.predict(X_test)
    
    f1 = f1_score(y_test_enc, pred, pos_label=0)
    recall = recall_score(y_test_enc, pred, pos_label=0)
    acc = accuracy_score(y_test_enc, pred)
    
    print(f"weight={weight} | F1={f1:.3f} | Recall={recall:.3f} | Accuracy={acc:.3f}")


